      "Bash(npm install*)",
      "Bash(npm start*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(node --test*)",
      "Bash(node -e*)",
      "Bash(electron .*)",
      "Bash(git status*)",
